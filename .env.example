# Copy to .env for local development only. Never commit real values.
# Paper and backtest modes need no exchange credentials.
# Use separate keys per environment; trade-only permissions, withdrawals disabled.

ARBITRON_EXCHANGE_API_KEY=
ARBITRON_EXCHANGE_API_SECRET=
# Only for exchanges that require a passphrase
ARBITRON_EXCHANGE_API_PASSWORD=

# PostgreSQL (async psycopg driver). Matches deploy/compose.dev.yaml for local dev.
ARBITRON_DATABASE_URL=postgresql+psycopg://arbitron:arbitron@localhost:5432/arbitron

# Telegram alerts ([alerts] channel = "telegram"). Create a bot with @BotFather;
# send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
ARBITRON_TELEGRAM_BOT_TOKEN=
ARBITRON_TELEGRAM_CHAT_ID=
