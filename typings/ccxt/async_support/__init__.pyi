from typing import Any

class Exchange:
    id: str
    has: dict[str, object]
    precisionMode: int
    urls: dict[str, Any]
    markets: dict[str, dict[str, object]] | None
    def __init__(self, config: dict[str, Any] = ...) -> None: ...
    def set_sandbox_mode(self, enabled: bool) -> None: ...
    async def load_markets(
        self, reload: bool = ..., params: dict[str, Any] = ...
    ) -> dict[str, dict[str, object]]: ...
    async def fetch_ohlcv(
        self,
        symbol: str,
        timeframe: str = ...,
        since: int | None = ...,
        limit: int | None = ...,
        params: dict[str, Any] = ...,
    ) -> list[list[object]]: ...
    async def fetch_ticker(
        self, symbol: str, params: dict[str, Any] = ...
    ) -> dict[str, object]: ...
    async def fetch_time(self, params: dict[str, Any] = ...) -> int | None: ...
    async def fetch_balance(self, params: dict[str, Any] = ...) -> dict[str, object]: ...
    async def create_order(
        self,
        symbol: str,
        type: str,
        side: str,
        amount: float,
        price: float | None = ...,
        params: dict[str, Any] = ...,
    ) -> dict[str, object]: ...
    async def cancel_order(
        self, id: str, symbol: str | None = ..., params: dict[str, Any] = ...
    ) -> dict[str, object]: ...
    async def fetch_order(
        self, id: str, symbol: str | None = ..., params: dict[str, Any] = ...
    ) -> dict[str, object]: ...
    async def fetch_open_orders(
        self,
        symbol: str | None = ...,
        since: int | None = ...,
        limit: int | None = ...,
        params: dict[str, Any] = ...,
    ) -> list[dict[str, object]]: ...
    async def fetch_my_trades(
        self,
        symbol: str | None = ...,
        since: int | None = ...,
        limit: int | None = ...,
        params: dict[str, Any] = ...,
    ) -> list[dict[str, object]]: ...
    def amount_to_precision(self, symbol: str, amount: float) -> str: ...
    def price_to_precision(self, symbol: str, price: float) -> str: ...
    async def fetch(
        self,
        url: str,
        method: str = ...,
        headers: dict[str, Any] | None = ...,
        body: Any = ...,
    ) -> Any: ...
    async def close(self) -> None: ...

class binance(Exchange): ...
